{
    "name": "edilsonteodoromathiasjunior/php-integration-melhor-envio",
    "description": "Biblioteca para facilitar a integração com o Melhor Envio.",
    "type": "library",
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "authors": [
        {
            "name": "edilson junior",
            "email": "edilsonjrdev99@gmail.com"
        }
    ],
    "require": {
        "vlucas/phpdotenv": "^5.6",
        "guzzlehttp/guzzle": "^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3"
    },
    "scripts": {
        "test": "php /vendor/bin/phpunit --colors",
        "test:html": "php vendor/bin/phpunit --testdox-html resultado.html && open resultado.html"
    }
}
